# Clave de Groq (obligatoria). Obtener gratis en https://console.groq.com/keys
GROQ_API_KEY=tu_clave_aqui

# Modelo y parámetros del agente (opcionales)
URBAN_MODEL=openai/gpt-oss-120b
URBAN_REASONING_EFFORT=low
URBAN_MAX_TOKENS=1200
URBAN_TEMPERATURE=0
URBAN_MAX_RETRIES=5

# Memoria (opcionales)
URBAN_VENTANA=8
URBAN_RESUMEN_EN=12
